# 模型提供商协议（可选）：
# - openai-chat（Chat Completions API，推荐，兼容 DeepSeek / Ollama 等）
# - openai-responses（OpenAI Responses API）
# - anthropic（Anthropic Messages API，支持 Claude 3.5 / 3.7）
# 若未显式设置，则依据 BASE_URL/MODEL/ANTHROPIC_API_KEY 自动判断
# PROVIDER=openai-chat

# OpenAI 基础配置
BASE_URL=https://api.openai.com/v1
API_KEY=your_api_key_here
MODEL=gpt-4o

# DeepSeek 示例配置（取消注释即可）：
# PROVIDER=openai-chat
# BASE_URL=https://api.deepseek.com
# API_KEY=your_deepseek_api_key
# MODEL=deepseek-chat

# Anthropic / Claude 示例配置（取消注释即可）：
# PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key
# ANTHROPIC_BASE_URL=https://your-proxy-endpoint.com
# MODEL=claude-3-7-sonnet-20250219

# 可选：按实际模型填写上下文窗口，省略或设为 0 时关闭自动压缩
CONTEXT_WINDOW=128000
